<odoo>
    <record id="view_payroll_tax_export_wizard_form" model="ir.ui.view">
        <field name="name">payroll.tax.export.wizard.form</field>
        <field name="model">payroll.tax.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Payroll Tax Export">
                <group>
                    <group>
                        <field name="company_id"/>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('file_data', '=', False)]}">
                    <field name="file_name" readonly="1"/>
                    <field name="file_data" filename="file_name" readonly="1"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export Monthly Tax File" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_tax_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Monthly Tax File</field>
        <field name="res_model">payroll.tax.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="payroll_tax_monthly_export_server_action" model="ir.actions.server">
        <field name="name">Export Monthly Tax File</field>
        <field name="model_id" ref="model_payroll_tax_monthly_report"/>
        <field name="binding_model_id" ref="model_payroll_tax_monthly_report"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env.ref('max_payroll_tax_export.action_payroll_tax_export_wizard').read()[0]</field>
    </record>
</odoo>
