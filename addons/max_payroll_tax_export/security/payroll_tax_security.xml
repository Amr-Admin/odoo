<odoo>
    <record id="payroll_tax_monthly_report_rule" model="ir.rule">
        <field name="name">Payroll Tax Monthly Report Multi Company</field>
        <field name="model_id" ref="model_payroll_tax_monthly_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll.group_hr_payroll_user')), (4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
</odoo>
